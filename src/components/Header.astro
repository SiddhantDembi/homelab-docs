---
import { getCollection } from 'astro:content';
import { Moon, Search, Sun } from '@lucide/astro';
import { getPublishedDocs, getSectionTitle, getSectionUrl, groupDocsBySection } from '../lib/docs';

const allDocs = await getCollection('docs');
const docs = getPublishedDocs(allDocs);
const sections = Object.keys(groupDocsBySection(docs));

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/siddhantdembi',
    icon: 'linkedin',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/siddhantdembi',
    icon: 'github',
  },
  {
    label: 'Twitter',
    href: 'https://twitter.com/siddhantdembi',
    icon: 'twitter',
  },
];
---

<header data-pagefind-ignore>
  <div class="nav">
    <nav class="primary-nav">
      <a href="/">Home</a>
      <a href="/resume">Resume</a>
      <a href="/#about">About</a>
      {sections.map((section) => <a href={getSectionUrl(section)}>{getSectionTitle(section, allDocs)}</a>)}
    </nav>

    <div class="nav-actions">
      <div class="site-tools">
        <a class="icon-button" href="/search/" aria-label="Search" title="Search">
          <Search size={18} stroke-width={1.8} aria-hidden="true" />
        </a>

        <button class="icon-button theme-toggle" type="button" aria-label="Use dark mode" title="Use dark mode">
          <Moon class="theme-icon theme-icon-moon" size={18} stroke-width={1.8} aria-hidden="true" />
          <Sun class="theme-icon theme-icon-sun" size={18} stroke-width={1.8} aria-hidden="true" />
        </button>
      </div>

      <div class="social-icons" aria-label="Social links">
        {socials.map((social) => (
          <a href={social.href} aria-label={social.label} target="_blank" rel="noreferrer">
            {social.icon === 'linkedin' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M6.94 8.5v8.56H4.09V8.5h2.85ZM5.52 7.33c-.91 0-1.52-.63-1.52-1.42s.62-1.41 1.55-1.41 1.51.62 1.52 1.41c0 .79-.6 1.42-1.55 1.42ZM20 12.15v4.91h-2.84v-4.58c0-1.15-.41-1.94-1.44-1.94-.79 0-1.25.53-1.46 1.04-.08.18-.1.43-.1.68v4.8H11.3s.04-7.79 0-8.56h2.85v1.21c.38-.59 1.05-1.43 2.56-1.43 1.87 0 3.29 1.22 3.29 3.87Z"
                  fill="currentColor"
                />
              </svg>
            )}
            {social.icon === 'github' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 2C6.48 2 2 6.58 2 12.22c0 4.51 2.87 8.33 6.84 9.68.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.91-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.67.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.4 9.4 0 0 1 12 6.84c.85 0 1.7.12 2.49.36 1.9-1.33 2.74-1.05 2.74-1.05.56 1.42.21 2.46.11 2.72.64.71 1.03 1.62 1.03 2.74 0 3.94-2.35 4.8-4.58 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.22C22 6.58 17.52 2 12 2Z"
                  fill="currentColor"
                />
              </svg>
            )}
            {social.icon === 'twitter' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M18.9 2H22l-6.78 7.75L23 22h-6.1l-4.77-6.24L6.67 22H3.56l7.25-8.29L1.5 2h6.25l4.3 5.69L18.9 2Zm-1.07 18.17h1.69L6.84 3.74H5.02l12.81 16.43Z"
                  fill="currentColor"
                />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  const updateThemeButton = () => {
    if (!themeToggle) return;

    const isDark = document.documentElement.dataset.theme === 'dark';
    const label = isDark ? 'Use light mode' : 'Use dark mode';
    themeToggle.setAttribute('aria-label', label);
    themeToggle.setAttribute('title', label);
  };

  themeToggle?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;

    try {
      localStorage.setItem('theme', theme);
    } catch {
      // The selected theme still applies for the current page.
    }

    updateThemeButton();
  });

  updateThemeButton();
</script>

<style>
  header {
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  .primary-nav {
    display: flex;
    flex: 1;
    gap: 28px;
    justify-content: flex-start;
  }

  .primary-nav a {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .primary-nav a:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-tools {
    display: flex;
    align-items: center;
    gap: 2px;
    padding-right: 12px;
    border-right: 1px solid var(--border);
  }

  .icon-button {
    display: inline-flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .icon-button:hover {
    background: var(--surface-strong);
    color: var(--text);
  }

  .theme-icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-icon-moon {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-icon-sun {
    display: block;
  }

  .social-icons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-icons a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-icons a:hover {
    color: var(--text);
  }

  .social-icons svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  @media (max-width: 600px) {
    .nav {
      padding: 16px 20px;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }

    .primary-nav {
      gap: 16px;
      order: 3;
      flex-basis: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .primary-nav a {
      font-size: 0.8rem;
    }

    .social-icons {
      gap: 8px;
    }

    .social-icons svg {
      width: 16px;
      height: 16px;
    }

    .site-tools {
      padding-right: 10px;
    }
  }
</style>
