---
import { getDocUrl } from '../lib/docs';
import type { DocEntry } from '../lib/docs';

interface Props {
  doc: DocEntry;
  number?: string;
}

const { doc, number } = Astro.props;
---

<a class="doc-card" href={getDocUrl(doc)}>
  {number && <span class="number">{number}</span>}
  <span class="content">
    <strong>{doc.data.title}</strong>
    <span>{doc.data.description}</span>
  </span>
</a>

<style>
  .doc-card {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: var(--space-6) var(--space-4);
    border-bottom: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .doc-card:first-child {
    border-top: 1px solid var(--border);
  }

  .number {
    color: var(--text-faint);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .content strong {
    font-size: 1.35rem;
    line-height: 1.25;
    letter-spacing: 0;
    transition: color var(--transition-fast);
  }

  .content span {
    max-width: 680px;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .doc-card:hover {
    background: var(--surface);
    transform: translateX(4px);
  }

  .doc-card:hover strong {
    color: var(--accent-strong);
  }

  .doc-card:active {
    transform: translateX(2px);
  }

  @media (max-width: 600px) {
    .doc-card {
      grid-template-columns: 36px 1fr;
      gap: 12px;
      padding: var(--space-5) var(--space-2);
    }

    .content strong {
      font-size: 1.15rem;
    }
  }
</style>
