---
import { getDocUrl } from '../lib/docs';
import type { DocEntry } from '../lib/docs';

interface Props {
  doc: DocEntry;
  number?: string;
}

const { doc, number } = Astro.props;
---

<a class="doc-card" href={getDocUrl(doc)}>
  {number && <span class="number">{number}</span>}
  <span class="content">
    <strong>{doc.data.title}</strong>
    <span>{doc.data.description}</span>
  </span>
</a>

<style>
  .doc-card {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 28px 0;
    border-bottom: 1px solid #ddd;
    color: inherit;
    text-decoration: none;
  }

  .doc-card:first-child {
    border-top: 1px solid #ddd;
  }

  .number {
    color: #999;
    font-size: 0.8rem;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .content strong {
    font-size: 1.35rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .content span {
    max-width: 680px;
    color: #666;
    line-height: 1.65;
  }

  .doc-card:hover strong {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 600px) {
    .doc-card {
      grid-template-columns: 36px 1fr;
      gap: 12px;
      padding: 24px 0;
    }

    .content strong {
      font-size: 1.15rem;
    }
  }
</style>
