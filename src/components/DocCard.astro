---
import { ArrowRight } from '@lucide/astro';
import { getDocUrl } from '../lib/docs';
import type { DocEntry } from '../lib/docs';

interface Props {
  doc: DocEntry;
  number?: string;
}

const { doc, number } = Astro.props;
---

<a class="doc-card" href={getDocUrl(doc)}>
  {number && <span class="number">{number}</span>}
  <span class="content">
    <strong>{doc.data.title}</strong>
    <span>{doc.data.description}</span>
  </span>
  <ArrowRight class="arrow" size={17} stroke-width={1.6} aria-hidden="true" />
</a>

<style>
  .doc-card {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 20px;
    gap: 18px;
    align-items: start;
    padding: 18px 8px;
    border-bottom: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .number {
    padding-top: 3px;
    color: var(--text-faint);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .content strong {
    font-size: 1.15rem;
    line-height: 1.25;
    letter-spacing: 0;
    transition: color var(--transition-fast);
  }

  .content span {
    max-width: 680px;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .arrow {
    margin-top: 4px;
    color: var(--text-faint);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .doc-card:hover {
    background: var(--surface);
    transform: translateX(2px);
  }

  .doc-card:hover strong,
  .doc-card:hover .arrow {
    color: var(--accent-strong);
  }

  .doc-card:hover .arrow {
    transform: translateX(2px);
  }

  .doc-card:active {
    transform: translateX(1px);
  }

  @media (max-width: 600px) {
    .doc-card {
      grid-template-columns: 28px minmax(0, 1fr) 18px;
      gap: 12px;
      padding: var(--space-5) 4px;
    }

    .content strong {
      font-size: 1.05rem;
    }

    .content span {
      font-size: 0.9rem;
    }
  }
</style>
