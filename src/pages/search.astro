---
import { getCollection } from 'astro:content';
import { Search } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import {
  getDocParts,
  getDocUrl,
  getPublishedDocs,
  getSectionTitle,
  sortDocs,
} from '../lib/docs';

const allDocs = await getCollection('docs');
const fallbackResults = sortDocs(getPublishedDocs(allDocs)).map((doc) => {
  const { section } = getDocParts(doc);

  return {
    url: getDocUrl(doc),
    title: doc.data.title,
    description: doc.data.description,
    section: getSectionTitle(section, allDocs),
    tags: doc.data.tags,
  };
});
---

<Layout
  title="Search — Siddhant Dembi"
  description="Search Siddhant Dembi's technical articles and homelab documentation."
>
  <main class="search-page" data-pagefind-ignore>
    <header class="search-header">
      <p class="eyebrow">SEARCH</p>
      <h1>Find an article</h1>
      <p>Search across documentation, experiments, and technical notes.</p>
    </header>

    <form class="search-form" role="search">
      <label class="sr-only" for="site-search">Search articles</label>
      <Search class="search-icon" size={21} stroke-width={1.8} aria-hidden="true" />
      <input
        id="site-search"
        name="q"
        type="search"
        placeholder="Search articles..."
        autocomplete="off"
        spellcheck="false"
      />
    </form>

    <p class="search-status" aria-live="polite">Start typing to search.</p>
    <section class="search-results" aria-label="Search results"></section>
  </main>
</Layout>

<script define:vars={{ fallbackResults }}>
  const form = document.querySelector('.search-form');
  const input = document.querySelector('#site-search');
  const status = document.querySelector('.search-status');
  const resultsContainer = document.querySelector('.search-results');
  let pagefindPromise;
  let searchSequence = 0;

  const getPagefind = () => {
    if (!pagefindPromise) {
      const pagefindPath = '/pagefind/pagefind.js';
      pagefindPromise = import(/* @vite-ignore */ pagefindPath)
        .then(async (pagefind) => {
          await pagefind.init();
          return pagefind;
        })
        .catch(() => null);
    }

    return pagefindPromise;
  };

  const cleanUrl = (url) => url.replace(/\.html$/, '').replace(/\/index$/, '/');

  const createResult = ({ url, title, excerpt, section }) => {
    const link = document.createElement('a');
    link.className = 'search-result';
    link.href = cleanUrl(url);

    const meta = document.createElement('span');
    meta.className = 'result-section';
    meta.textContent = section || 'Article';

    const heading = document.createElement('strong');
    heading.textContent = title;

    const summary = document.createElement('span');
    summary.className = 'result-excerpt';
    summary.innerHTML = excerpt;

    link.append(meta, heading, summary);
    return link;
  };

  const searchFallback = (query) => {
    const normalizedQuery = query.toLowerCase();

    return fallbackResults
      .filter((result) =>
        [result.title, result.description, result.section, ...result.tags]
          .join(' ')
          .toLowerCase()
          .includes(normalizedQuery),
      )
      .map((result) => ({ ...result, excerpt: result.description }));
  };

  const runSearch = async () => {
    const query = input.value.trim();
    const currentSearch = ++searchSequence;
    const url = new URL(window.location.href);

    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);

    resultsContainer.replaceChildren();

    if (query.length < 2) {
      status.textContent = query.length === 1 ? 'Enter one more character to search.' : 'Start typing to search.';
      return;
    }

    status.textContent = 'Searching...';
    const pagefind = await getPagefind();
    let results;

    if (pagefind) {
      const search = await pagefind.search(query);
      const loadedResults = await Promise.all(search.results.slice(0, 20).map((result) => result.data()));

      results = loadedResults.map((result) => {
        const article = fallbackResults.find(
          (fallbackResult) => cleanUrl(fallbackResult.url) === cleanUrl(result.url),
        );

        return {
          url: result.url,
          title: article?.title ?? result.meta.title.replace(/ — Siddhant Dembi$/, ''),
          excerpt: result.excerpt,
          section: article?.section ?? 'Page',
        };
      });
    } else {
      results = searchFallback(query);
    }

    if (currentSearch !== searchSequence) return;

    status.textContent = results.length === 0
      ? `No results for “${query}”.`
      : `${results.length} ${results.length === 1 ? 'result' : 'results'} for “${query}”.`;

    resultsContainer.append(...results.map(createResult));
  };

  let debounceTimer;
  input.addEventListener('input', () => {
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(runSearch, 180);
  });

  input.addEventListener('focus', getPagefind, { once: true });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(debounceTimer);
    runSearch();
  });

  const initialQuery = new URL(window.location.href).searchParams.get('q');
  if (initialQuery) {
    input.value = initialQuery;
    runSearch();
  }
</script>

<style is:global>
  .search-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 80px 24px 100px;
  }

  .search-header {
    max-width: 700px;
    margin-bottom: 44px;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    line-height: 1;
  }

  .search-header > p:last-child {
    margin: 22px 0 0;
    color: var(--text-soft);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .search-form {
    position: relative;
    max-width: 720px;
  }

  .search-icon {
    position: absolute;
    top: 50%;
    left: 18px;
    color: var(--text-muted);
    pointer-events: none;
    transform: translateY(-50%);
  }

  input {
    width: 100%;
    height: 56px;
    padding: 0 18px 0 52px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--background);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }

  input::placeholder {
    color: var(--text-faint);
  }

  input:focus {
    border-color: var(--accent);
  }

  .search-status {
    min-height: 24px;
    margin: 24px 0 10px;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .search-results {
    max-width: 720px;
  }

  .search-result {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .search-result:first-child {
    border-top: 1px solid var(--border);
  }

  .result-section {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .search-result strong {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .result-excerpt {
    color: var(--text-muted);
    line-height: 1.65;
  }

  .search-result:hover strong {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .search-result mark {
    background: transparent;
    color: var(--accent);
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .search-page {
      padding: 56px 20px 80px;
    }

    .search-header {
      margin-bottom: 36px;
    }

    input {
      height: 52px;
    }
  }
</style>
