---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getDocParts, getPublishedDocs, getSectionTitle } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = getPublishedDocs(await getCollection('docs'));

  return docs.map((doc) => {
    const { section, slug } = getDocParts(doc);

    return {
      params: { section, slug },
      props: { doc, docs },
    };
  });
}

const { doc, docs } = Astro.props;
const { section } = getDocParts(doc);
const { Content, headings } = await render(doc);
---

<DocLayout
  title={doc.data.title}
  description={doc.data.description}
  eyebrow={`${getSectionTitle(section, docs).toUpperCase()} / ${String(doc.data.order).padStart(2, '0')}`}
  tags={doc.data.tags}
  headings={headings}
>
  <Content />
</DocLayout>
