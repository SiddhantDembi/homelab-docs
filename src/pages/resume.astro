---
import { Download } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import resumeData from '../data/resume-links.json';

const resumeDownload = '/resume/SiddhantDembi.pdf';
---

<Layout
  title="Resume — Siddhant Dembi"
  description="Resume for Siddhant Dembi, viewable directly within the site."
>
  <main class="resume-page" data-pagefind-body>
    <section class="resume-header">
      <h2>Resume</h2>
    </section>

    <section id="resume-viewer" class="resume-viewer">
      {resumeData.pages.map((page, pageIndex) => (
        <div class="resume-preview" style={`aspect-ratio: ${page.width} / ${page.height};`}>
          <img src={page.image} alt={`Siddhant Dembi resume, page ${pageIndex + 1}`} />
          {page.links.map((link) => (
            <a
              class="resume-link"
              href={link.href}
              aria-label={link.label}
              style={`left: ${(link.left / page.width) * 100}%; top: ${(link.top / page.height) * 100}%; width: ${(link.width / page.width) * 100}%; height: ${(link.height / page.height) * 100}%;`}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            ></a>
          ))}
        </div>
      ))}
    </section>

    <div class="resume-actions">
      <a class="download-button" href={resumeDownload} download="SiddhantDembi.pdf" type="application/pdf">
        <Download size={18} stroke-width={1.8} aria-hidden="true" />
        Download PDF
      </a>
    </div>
  </main>
</Layout>

<style>
  .resume-page { max-width: var(--page-width); margin: 0 auto; padding: var(--space-8) 24px var(--space-8); }
  .resume-header { margin-bottom: var(--space-7); }
  .eyebrow { margin: 0 0 14px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; color: var(--text-muted); }
  h2 { margin: 0; font-size: clamp(2.7rem, 6vw, 4.75rem); line-height: 1; letter-spacing: -0.035em; }
  .resume-viewer { display: grid; gap: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5); background: var(--surface); box-shadow: var(--shadow-sm); }
  .resume-preview { position: relative; width: 100%; overflow: hidden; border-radius: var(--radius-sm); background: white; }
  .resume-preview img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .resume-link { position: absolute; display: block; cursor: pointer; }
  .resume-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; background: color-mix(in srgb, var(--accent) 20%, transparent); }
  .resume-actions { display: flex; justify-content: center; margin-top: 24px; padding-bottom: 12px; }
  .download-button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; gap: 9px; border: 1px solid var(--text); border-radius: var(--radius-sm); background: var(--text); color: var(--button-text); font-size: 0.95rem; font-weight: 600; text-decoration: none; transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast); }
  .download-button:hover { border-color: var(--accent); background: var(--accent); color: var(--background); transform: translateY(-1px); }
  .download-button:active { transform: translateY(0); }
  @media (max-width: 800px) { .resume-page { padding: var(--space-8) 20px var(--space-6); } .resume-viewer { gap: var(--space-2); padding: var(--space-2); border-radius: var(--radius-md); } .resume-actions { margin-top: var(--space-5); padding-bottom: 0; } .download-button { width: 100%; min-height: 48px; } }
</style>
