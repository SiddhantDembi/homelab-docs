---
import { Download } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import resumeData from '../data/resume-links.json';

const resumeDownload = '/resume/SiddhantDembi.pdf';
---

<Layout
  title="Resume — Siddhant Dembi"
  description="Resume for Siddhant Dembi, viewable directly within the site."
>
  <main class="resume-page" data-pagefind-body>
    <section class="resume-header">
      <p class="eyebrow">RESUME</p>
      <h1>Siddhant Dembi</h1>
    </section>

    <section id="resume-viewer" class="resume-viewer">
      {resumeData.pages.map((page, pageIndex) => (
        <div class="resume-preview" style={`aspect-ratio: ${page.width} / ${page.height};`}>
          <img src={page.image} alt={`Siddhant Dembi resume, page ${pageIndex + 1}`} />
          {page.links.map((link) => (
            <a
              class="resume-link"
              href={link.href}
              aria-label={link.label}
              style={`left: ${(link.left / page.width) * 100}%; top: ${(link.top / page.height) * 100}%; width: ${(link.width / page.width) * 100}%; height: ${(link.height / page.height) * 100}%;`}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            ></a>
          ))}
        </div>
      ))}
    </section>

    <div class="resume-actions">
      <a class="download-button" href={resumeDownload} download="SiddhantDembi.pdf" type="application/pdf">
        <Download size={18} stroke-width={1.8} aria-hidden="true" />
        Download PDF
      </a>
    </div>
  </main>
</Layout>

<style>
  .resume-page { max-width: 1100px; margin: 0 auto; padding: 56px 24px 32px; }
  .resume-header { margin-bottom: 28px; }
  .eyebrow { margin: 0 0 14px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; color: var(--text-muted); }
  h1 { margin: 0; font-size: clamp(2.4rem, 6vw, 4.5rem); line-height: 1; letter-spacing: 0; }
  .resume-viewer { display: grid; gap: 18px; border: 1px solid var(--border); border-radius: 8px; padding: 18px; background: var(--surface); }
  .resume-preview { position: relative; width: 100%; overflow: hidden; background: white; }
  .resume-preview img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .resume-link { position: absolute; display: block; cursor: pointer; }
  .resume-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; background: color-mix(in srgb, var(--accent) 20%, transparent); }
  .resume-actions { display: flex; justify-content: center; margin-top: 24px; padding-bottom: 12px; }
  .download-button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; gap: 9px; border: 1px solid var(--text); border-radius: 6px; background: var(--text); color: var(--button-text); font-size: 0.95rem; font-weight: 600; text-decoration: none; transition: background 0.2s ease, color 0.2s ease; }
  .download-button:hover { border-color: var(--accent); background: var(--accent); color: var(--background); }
  @media (max-width: 800px) { .resume-page { padding: 40px 20px 24px; } .resume-viewer { gap: 8px; padding: 8px; } .resume-actions { margin-top: 20px; padding-bottom: 0; } .download-button { width: 100%; min-height: 48px; } }
</style>
