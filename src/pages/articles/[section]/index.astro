---
import { getCollection } from 'astro:content';
import { getDocParts, getPublishedDocs } from '../../../lib/docs';

export async function getStaticPaths() {
  const docs = getPublishedDocs(await getCollection('docs'));
  const sections = [...new Set(docs.map((doc) => getDocParts(doc).section))];

  return sections.map((section) => ({
    params: { section },
  }));
}

const { section } = Astro.params;

return Astro.redirect(`/articles/#${section}`, 301);
---
