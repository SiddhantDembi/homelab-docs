---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DocCard from '../components/DocCard.astro';
import {
  getPublishedDocs,
  getSectionOrder,
  getSectionTitle,
  groupDocsBySection,
} from '../lib/docs';

const allDocs = await getCollection('docs');
const docs = getPublishedDocs(allDocs);
const groupedDocs = groupDocsBySection(docs);
const sections = Object.entries(groupedDocs)
  .sort(([firstId], [secondId]) => {
    const orderDifference = getSectionOrder(firstId, allDocs) - getSectionOrder(secondId, allDocs);

    if (orderDifference !== 0) return orderDifference;

    return getSectionTitle(firstId, allDocs).localeCompare(getSectionTitle(secondId, allDocs));
  })
  .map(([id, sectionDocs]) => ({
    id,
    title: getSectionTitle(id, allDocs),
    docs: sectionDocs.map((doc, index) => ({
      doc,
      number: String(index + 1).padStart(2, '0'),
    })),
  }));
---

<Layout
  title="Articles — Siddhant Dembi"
  description="Technical articles and documentation by Siddhant Dembi."
>
  <main class="page" data-pagefind-body>
    <header class="page-header">
      <h1>Articles</h1>
      <p class="page-intro">Technical notes, projects, and build logs from my homelab.</p>
      <p class="article-count">{docs.length} {docs.length === 1 ? 'write-up' : 'write-ups'}</p>
    </header>

    <div class="article-index">
      {sections.map((section) => (
        <section class="article-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
          <header class="section-header">
            <h2 id={`${section.id}-heading`}>{section.title}</h2>
            <p>
              {section.docs.length} {section.docs.length === 1 ? 'write-up' : 'write-ups'}
            </p>
          </header>

          <div class="article-list">
            {section.docs.map(({ doc, number }) => <DocCard doc={doc} number={number} />)}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-9) 24px calc(var(--space-9) + var(--space-5));
  }

  .page-header {
    margin-bottom: var(--space-7);
  }

  .page-header h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .page-intro {
    margin: 18px 0 0;
    color: var(--text-muted);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .article-count {
    margin: 8px 0 0;
    color: var(--text-faint);
    font-size: 0.9rem;
  }

  .article-section {
    scroll-margin-top: calc(72px + var(--space-5));
  }

  .article-section + .article-section {
    margin-top: var(--space-7);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .section-header h2 {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-header p {
    margin: 0;
    color: var(--text-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .page {
      padding: var(--space-8) 20px var(--space-9);
    }

    .page-header {
      margin-bottom: var(--space-6);
    }

    .page-intro {
      font-size: 1rem;
    }

    .article-section + .article-section {
      margin-top: var(--space-6);
    }
  }
</style>
