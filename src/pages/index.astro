---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {
  getPublishedDocs,
  getSectionDescription,
  getSectionTitle,
  getSectionUrl,
  groupDocsBySection,
} from '../lib/docs';

const docs = getPublishedDocs(await getCollection('docs'));
const groupedDocs = groupDocsBySection(docs);
const sections = Object.keys(groupedDocs);
---

<Layout
  title="Siddhant Dembi — Homelab"
  description="Technical write-ups covering my homelab infrastructure, local AI systems, automation, networking, monitoring and backups."
>
  <main>
    <section class="hero">
      <h1>Siddhant Dembi</h1>

      <p class="intro">
        Tech enthusiast documenting my journey through DevOps, infrastructure,
        local AI, automation and homelabing.
      </p>
    </section>

    <section id="about" class="about-section">
      <div class="section-header">
        <h2 class="eyebrow">ABOUT</h2>
      </div>

      <div class="about-grid">
        <p>
          I am Siddhant, and this space is where I document the systems I build,
          break, rebuild, and learn from. Most of my work sits around homelab
          infrastructure, automation, self-hosting, networking, and practical
          DevOps experiments.
        </p>

        <p>
          I like turning messy notes into clear write-ups that are useful later,
          both for me and for anyone trying to build something similar. Each
          section here is meant to be a living record of decisions, setups,
          lessons, and improvements over time.
        </p>
      </div>
    </section>

    <section>
      <div class="section-header">
        <p class="eyebrow">DOCS</p>
        <h2>Sections &amp; Write-ups</h2>
      </div>

      <div class="project-grid">
        {sections.map((section, index) => (
          <article class="project-card">
            <p class="project-number">{String(index + 1).padStart(2, '0')}</p>
            <h3>{getSectionTitle(section, docs)}</h3>
            <p>{getSectionDescription(section, docs)}</p>
            <a href={getSectionUrl(section)}>
              {groupedDocs[section].length} {groupedDocs[section].length === 1 ? 'write-up' : 'write-ups'} →
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 24px 48px;
  }

  .hero {
    max-width: 760px;
    margin-bottom: 100px;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #666;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .intro {
    max-width: 680px;
    margin-top: 28px;
    font-size: 1.25rem;
    line-height: 1.7;
    color: #555;
  }

  .section-header {
    margin-bottom: 32px;
  }

  .section-header h2 {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .about-section {
    margin-bottom: 100px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .about-grid p {
    margin: 0;
    color: #555;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .project-card {
    padding: 28px;
    border: 1px solid #ddd;
    border-radius: 12px;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .project-card:hover {
    border-color: #999;
    transform: translateY(-2px);
  }

  .project-number {
    margin: 0 0 24px;
    color: #888;
    font-size: 0.8rem;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .project-card p:not(.project-number) {
    min-height: 110px;
    margin: 16px 0 24px;
    color: #666;
    line-height: 1.6;
  }

  .project-card a,
  .project-card a {
    color: #111;
    font-weight: 600;
    text-decoration: none;
  }

  .project-card a:hover {
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    main {
      padding-top: 48px;
    }

    .hero {
      margin-bottom: 64px;
    }

    .about-section {
      margin-bottom: 64px;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card p:not(.project-number) {
      min-height: auto;
    }
  }
</style>
