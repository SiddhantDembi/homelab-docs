---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Siddhant Dembi — Homelab"
  description="Technical write-ups covering my homelab infrastructure, local AI systems, automation, networking, monitoring and backups."
>
  <main>
    <section class="hero">
      <h1>Siddhant Dembi</h1>

      <p class="intro">
        Tech enthusiast documenting my journey through DevOps, infrastructure,
        local AI, automation and homelab engineering.
      </p>
    </section>

    <section class="projects">
      <div class="section-header">
        <p class="eyebrow">HOMELAB</p>
        <h2>Projects &amp; Write-ups</h2>
      </div>

      <div class="project-grid">

        <article class="project-card">
          <p class="project-number">01</p>
          <h3>Proxmox Homelab Infrastructure</h3>
          <p>
            Three-node on-premise infrastructure covering virtualization,
            containers, Kubernetes, networking, DNS and secure remote access.
          </p>
          <a href="/homelab/proxmox/">Read write-up →</a>
        </article>

        <article class="project-card">
          <p class="project-number">02</p>
          <h3>Local AI &amp; LLM Platform</h3>
          <p>
            GPU-accelerated local AI infrastructure with Ollama, OpenWebUI,
            autonomous agents, workflow automation and observability.
          </p>
          <a href="/homelab/local-ai/">Read write-up →</a>
        </article>

        <article class="project-card">
          <p class="project-number">03</p>
          <h3>Infrastructure Monitoring &amp; Backup</h3>
          <p>
            Self-hosted monitoring, 3-2-1 backups, scheduled snapshots,
            resource tracking and automated infrastructure alerts.
          </p>
          <a href="/homelab/monitoring/">Read write-up →</a>
        </article>

      </div>
    </section>

    <footer>
      <a href="https://github.com/siddhantdembi">GitHub</a>
      <a href="https://www.linkedin.com/in/siddhantdembi">LinkedIn</a>
      <a href="https://dembi.xyz">Resume</a>
      <a>© Siddhant Dembi 2026</a>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 24px 48px;
  }

  .hero {
    max-width: 760px;
    margin-bottom: 100px;
  }

  .eyebrow {
    margin: 0 0 16px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #666;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .intro {
    max-width: 680px;
    margin-top: 28px;
    font-size: 1.25rem;
    line-height: 1.7;
    color: #555;
  }

  .section-header {
    margin-bottom: 32px;
  }

  .section-header h2 {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .project-card {
    padding: 28px;
    border: 1px solid #ddd;
    border-radius: 12px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    border-color: #999;
    transform: translateY(-2px);
  }

  .project-number {
    margin: 0 0 24px;
    color: #888;
    font-size: 0.8rem;
  }

  .project-card h3 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .project-card p:not(.project-number) {
    min-height: 110px;
    margin: 16px 0 24px;
    color: #666;
    line-height: 1.6;
  }

  .project-card a,
  footer a {
    color: #111;
    font-weight: 600;
    text-decoration: none;
  }

  .project-card a:hover,
  footer a:hover {
    text-decoration: underline;
  }

  footer {
    display: flex;
    gap: 24px;
    margin-top: 100px;
    padding-top: 24px;
    border-top: 1px solid #ddd;
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    main {
      padding-top: 48px;
    }

    .hero {
      margin-bottom: 64px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card p:not(.project-number) {
      min-height: auto;
    }

    footer {
      margin-top: 64px;
    }
  }
</style>