---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Siddhant Dembi — Homelab"
  description="Technical write-ups covering my homelab infrastructure, local AI systems, automation, networking, monitoring and backups."
>
  <main data-pagefind-body>
    <section class="hero">
      <h1>Siddhant Dembi</h1>

      <p class="intro">
        Tech enthusiast documenting my journey through DevOps, infrastructure,
        local AI, automation and homelabing.
      </p>
    </section>
  </main>
</Layout>

<style>
  main {
    display: grid;
    min-height: calc(100svh - 73px);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) 24px var(--space-9);
    align-items: center;
  }

  .hero {
    max-width: 760px;
    animation: hero-in 600ms ease both;
  }

  h1 {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(3.25rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 620px;
    margin: var(--space-6) 0 0;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.7;
    color: var(--text-soft);
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 800px) {
    main {
      min-height: auto;
      padding: var(--space-8) 20px var(--space-9);
    }
  }
</style>
