---
import Layout from './Layout.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  tags?: string[];
  headings?: MarkdownHeading[];
}

const { title, description, eyebrow = 'DOCS', tags = [], headings = [] } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2);
---

<Layout title={`${title} — Siddhant Dembi`} description={description}>
  <main class="article" data-pagefind-body>
    <header class="article-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="subtitle">{description}</p>

      {tags.length > 0 && (
        <div class="meta">
          {tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </header>

    <div class="article-layout">
      <article class="content">
        <slot />
      </article>

      {toc.length > 0 && (
        <aside class="toc">
          <p>ON THIS PAGE</p>
          {toc.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </aside>
      )}
    </div>
  </main>
</Layout>

<style is:global>
  .article {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-9) 24px 7.5rem;
  }

  .article-header {
    max-width: 800px;
    margin-bottom: var(--space-9);
  }

  .eyebrow {
    margin: 0 0 20px;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .article h1 {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(2.7rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .subtitle {
    max-width: 720px;
    margin: var(--space-6) 0 var(--space-5);
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.7;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .meta span {
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    background: var(--surface);
    font-size: 0.75rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 700px) 180px;
    gap: clamp(var(--space-7), 7vw, var(--space-9));
    align-items: start;
  }

  .content > * {
    margin-top: 0;
  }

  .content h2 {
    margin: 64px 0 20px;
    font-size: 1.8rem;
    letter-spacing: 0;
    scroll-margin-top: 30px;
  }

  .content h2:first-child {
    margin-top: 0;
  }

  .content h3 {
    margin: 32px 0 14px;
    font-size: 1.2rem;
  }

  .content p,
  .content li {
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .content p {
    margin-bottom: 20px;
  }

  .content a {
    color: var(--accent-strong);
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .content a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .content ul {
    margin: 0 0 20px;
    padding-left: 24px;
  }

  .content li {
    margin-bottom: 12px;
  }

  .toc {
    position: sticky;
    top: 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-left: 1px solid var(--border);
    padding-left: 20px;
  }

  .toc p {
    margin: 0 0 8px;
    color: var(--text-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .toc a {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .toc a:hover {
    color: var(--text);
    transform: translateX(3px);
  }

  .table-wrapper {
    margin-top: 28px;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    min-width: 560px;
  }

  th,
  td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  td {
    color: var(--text-soft);
    line-height: 1.6;
  }

  .architecture-diagram,
  .network-flow {
    margin-top: 32px;
    padding: 28px 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    text-align: center;
  }

  .architecture-diagram {
    padding: 32px 24px;
  }

  .diagram-box {
    display: inline-block;
    padding: 12px 18px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--background);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .diagram-line {
    width: 1px;
    height: 24px;
    margin: 0 auto;
    background: var(--border-strong);
  }

  .nodes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .node {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    text-align: left;
  }

  .node strong {
    font-size: 1rem;
  }

  .node span {
    margin-bottom: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .node small {
    color: var(--text-soft);
    font-size: 0.8rem;
  }

  .vm-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .vm-host {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--background);
  }

  .vm-host-header {
    padding: 20px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .vm-number {
    display: block;
    margin-bottom: 6px;
    color: var(--text-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .vm-host-header h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .vm-list {
    display: flex;
    flex-direction: column;
  }

  .vm-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 13px 20px;
    border-bottom: 1px solid var(--border);
  }

  .vm-item:last-child {
    border-bottom: none;
  }

  .vm-item strong {
    font-size: 0.85rem;
  }

  .vm-item span {
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .vm-item.lxc {
    background: var(--surface);
  }

  .templates-note {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-top: 20px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .templates-note strong {
    white-space: nowrap;
  }

  .templates-note span {
    color: var(--text-muted);
  }

  .network-box {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    min-width: 180px;
    padding: 14px 18px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--background);
  }

  .network-box strong {
    font-size: 0.85rem;
  }

  .network-box span {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .network-arrow {
    margin: 8px 0;
    color: var(--text-faint);
  }

  .network-services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 8px;
  }

  .network-services .network-box {
    width: 100%;
    min-width: 0;
  }

  .remote-access-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 32px;
  }

  .remote-access-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .remote-access-card strong {
    font-size: 0.9rem;
  }

  .remote-access-card span {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (max-width: 800px) {
    .article {
      padding: var(--space-8) 20px var(--space-9);
    }

    .article-layout {
      display: block;
    }

    .toc {
      display: none;
    }

    .article-header {
      margin-bottom: var(--space-8);
    }

    .nodes,
    .vm-grid,
    .network-services,
    .remote-access-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .article-header h1 {
      font-size: 2.8rem;
    }

    .subtitle {
      font-size: 1.05rem;
    }

    .content h2 {
      font-size: 1.55rem;
    }

    .content p,
    .content li {
      font-size: 1rem;
    }

    .templates-note {
      flex-direction: column;
      gap: 5px;
    }
  }
</style>
