---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Siddhant Dembi — Engineering & Homelab',
  description = 'Technical documentation covering DevOps, infrastructure, local AI, automation and homelabing.',
} = Astro.props;

import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <style is:global>
      :root {
        font-family: Georgia, 'Times New Roman', serif;
        color: #111;
        background: #fff;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;
        background: #fff;
      }

      a {
        color: inherit;
        cursor: pointer;
      }

      ::selection {
        background: #111;
        color: #fff;
      }
    </style>
  </head>

  <body>
	<Header />
    <slot />
  </body>
</html>
