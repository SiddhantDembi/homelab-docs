{
	"name": "homelab-docs",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"predev": "npm run prepare:resume",
		"dev": "astro dev",
		"prepare:resume": "node scripts/prepare-resume.mjs",
		"build": "npm run prepare:resume && astro build && pagefind --site dist/client",
		"preview": "npm run build && astro preview",
		"astro": "astro",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.2.0",
		"@astrojs/sitemap": "^3.7.3",
		"@lucide/astro": "^1.31.0",
		"astro": "^7.2.0"
	},
	"devDependencies": {
		"@napi-rs/canvas": "^1.0.5",
		"pagefind": "^1.5.2",
		"pdfjs-dist": "^6.2.108",
		"wrangler": "^4.120.1"
	}
}
